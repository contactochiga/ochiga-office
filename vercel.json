{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/office/"
    },
    {
      "source": "/dashboard.js",
      "destination": "/dashboard/dashboard.js"
    },
    {
      "source": "/widget.js",
      "destination": "/widget/oma-widget.js"
    },
    {
      "source": "/office.js",
      "destination": "/office/office.js"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/office-redirects-security": false,
      "codex/sp-office-release": false,
      "codex/sp-office-rollback": false
    }
  }
}
