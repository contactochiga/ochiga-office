{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/office/"
    },
    {
      "source": "/dashboard.js",
      "destination": "/dashboard/dashboard.js"
    },
    {
      "source": "/widget.js",
      "destination": "/widget/oma-widget.js"
    },
    {
      "source": "/office.js",
      "destination": "/office/office.js"
    }
  ]
}
