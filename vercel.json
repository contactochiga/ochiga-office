{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/office/"
    },
    {
      "source": "/dashboard.js",
      "destination": "/dashboard/dashboard.js"
    },
    {
      "source": "/widget.js",
      "destination": "/widget/oma-widget.js"
    },
    {
      "source": "/office.js",
      "destination": "/office/office.js"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/office-redirects-security": false,
      "codex/sp-office-release": false,
      "codex/sp-office-rollback": false,
      "codex/office-intake-package-fix": false,
      "codex/unified-engagement-office": false,
      "codex/content-workspace-refinement": false,
      "codex/whatsapp-media-contract": false,
      "codex/whatsapp-envelope-observation": false,
      "codex/meta-social-staff-replies": false,
      "codex/meta-social-inbound-channels": false,
      "codex/office-social-manual-outbound-d1": false,
      "codex/office-facebook-pilot-recipient-allowlist": false,
      "codex/office-meta-page-connection": false,
      "codex/office-content-social": false
    }
  }
}
