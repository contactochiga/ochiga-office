OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

LEAD_AGENTS_HOST=127.0.0.1
LEAD_AGENTS_PORT=8787
LEAD_AGENTS_REQUEST_TIMEOUT_MS=120000
LEAD_AGENTS_STORE_DRIVER=file
LEAD_AGENTS_STORE_PATH=./data/lead-agents-store.json
LEAD_AGENTS_DEFAULT_SOURCE=website_chat
LEAD_AGENTS_ALLOWED_ORIGINS=http://localhost:3000

# Canonical Ochiga Office browser origin for invite, activation and reset
# links. Production defaults to the verified domain below; set this explicitly
# for a future domain cutover. Do not point it at the API service.
OFFICE_APP_URL=https://office.ochiga.com.ng

LEAD_AGENTS_AUTH_MODE=required_api_key
LEAD_AGENTS_API_KEYS=
LEAD_AGENTS_ADMIN_EMAIL=
LEAD_AGENTS_ADMIN_PASSWORD=
LEAD_AGENTS_ADMIN_ROLE=admin
# Required in production: >=32 chars, dedicated (never an API key or another service secret).
LEAD_AGENTS_SESSION_SECRET=
# Deprecated, default off. Only the exact value "true" enables API-key-as-password sign-in.
# LEAD_AGENTS_ALLOW_API_KEY_LOGIN=
# Transient administrator recovery (needs ADMIN_EMAIL + a >=12 char ADMIN_PASSWORD). Remove after signing in.
# LEAD_AGENTS_ADMIN_RECOVERY=
LEAD_AGENTS_SESSION_TTL_MS=604800000
# Step-up (current-password) authorisation lifetime in ms; default 300000, hard maximum 600000.
# LEAD_AGENTS_STEP_UP_TTL_MS=
# Session revocation (S7.4). On by default; "off" disables generation checks and the revocation routes (rollback lever; schema is kept).
# LEAD_AGENTS_SESSION_REVOCATION=on
# After every instance runs S7.4, set true to refuse tokens issued before generations existed.
# LEAD_AGENTS_REJECT_LEGACY_SESSIONS=
# MFA (S7.5.1: key validation and readiness only; nothing enrolls or enforces yet). OFF by default. Never put a real key in this file.
# LEAD_AGENTS_MFA=off
# LEAD_AGENTS_MFA_KEY=            # 32 random bytes, Base64; dedicated (never the session secret or any other secret); set in the deployment dashboard only
# LEAD_AGENTS_MFA_KEY_ID=         # label of the current key, 1-32 of [A-Za-z0-9._-]
# LEAD_AGENTS_MFA_KEYS_PREVIOUS=  # retired keys during rotation: id:base64,id2:base64
# WebAuthn / passkeys (S7.5.5): unavailable until configured. No default domain exists; production additionally requires the owner's approval.
# LEAD_AGENTS_WEBAUTHN_RP_ID=      # registrable domain, e.g. localhost for local tests (set the production value only after the permanent domain is approved)
# LEAD_AGENTS_WEBAUTHN_ORIGINS=    # comma-separated https origins (http only for localhost/127.0.0.1, never in production)
# LEAD_AGENTS_WEBAUTHN_RP_NAME=    # display name shown by the authenticator
# LEAD_AGENTS_WEBAUTHN_RP_APPROVED= # production only: must equal the RP ID once the owner approved it
# LEAD_AGENTS_MFA_REQUIRED_ROLES=  # comma list of roles whose LAST active factor may not be removed (S7.5.4 guard only; sign-in enforcement is a later slice). Default: none.

LEAD_AGENTS_RATE_LIMIT_WINDOW_MS=60000
LEAD_AGENTS_RATE_LIMIT_MAX_REQUESTS=60

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

FOUNDER_ALERT_WEBHOOK_URL=
FOUNDER_ALERT_WEBHOOK_SECRET=
SALES_ALERT_WEBHOOK_URL=
SALES_ALERT_WEBHOOK_SECRET=
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=

OFFICE_FACILITY_BASE_URL=
OFFICE_FACILITY_API_KEY=
OFFICE_FACILITY_BEARER_TOKEN=
OFFICE_FACILITY_EXPORT_PATH=/office/export
OFFICE_CONSUMER_BASE_URL=
OFFICE_CONSUMER_API_KEY=
OFFICE_CONSUMER_BEARER_TOKEN=
OFFICE_CONSUMER_EXPORT_PATH=/office/export
OFFICE_BACKEND_BASE_URL=
OFFICE_BACKEND_API_KEY=
OFFICE_BACKEND_BEARER_TOKEN=

# Office's own publicly-reachable base URL (e.g. https://office.ochiga.com.ng).
# Used to resolve Office-hosted storage URLs into absolute URLs when
# uploading assets (e.g. Development cover images) onward to Sanity.
OFFICE_PUBLIC_BASE_URL=
OFFICE_BACKEND_CONVERSATION_PATH=/office/conversation/corporate
OFFICE_BACKEND_INTERNAL_CONVERSATION_PATH=/office/conversation/internal
OFFICE_BACKEND_EVENTS_ENABLED=false
OFFICE_BACKEND_EVENT_PATH=/office/events/material
OFFICE_BACKEND_EVENT_TIMEOUT_MS=10000
OFFICE_BACKEND_EVENT_MAX_ATTEMPTS=2

OFFICE_EMAIL_PROVIDER=resend
OFFICE_EMAIL_FROM=Ochiga Office <office@ochiga.com.ng>
RESEND_API_KEY=

OFFICE_MAP_PROVIDER=static
MAPBOX_PUBLIC_TOKEN=
GOOGLE_MAPS_API_KEY=
OFFICE_DOCUMENT_BRAND_NAME=OCHIGA OFFICE
OFFICE_STORAGE_DIR=./data/office-storage
