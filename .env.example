OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

LEAD_AGENTS_HOST=127.0.0.1
LEAD_AGENTS_PORT=8787
LEAD_AGENTS_REQUEST_TIMEOUT_MS=120000
LEAD_AGENTS_STORE_DRIVER=file
LEAD_AGENTS_STORE_PATH=./data/lead-agents-store.json
LEAD_AGENTS_DEFAULT_SOURCE=website_chat
LEAD_AGENTS_ALLOWED_ORIGINS=http://localhost:3000

# Canonical Ochiga Office browser origin for invite, activation and reset
# links. Production defaults to the verified domain below; set this explicitly
# for a future domain cutover. Do not point it at the API service.
OFFICE_APP_URL=https://office.ochiga.com.ng

LEAD_AGENTS_AUTH_MODE=required_api_key
LEAD_AGENTS_API_KEYS=
LEAD_AGENTS_ADMIN_EMAIL=
LEAD_AGENTS_ADMIN_PASSWORD=
LEAD_AGENTS_ADMIN_ROLE=admin
LEAD_AGENTS_SESSION_SECRET=
LEAD_AGENTS_SESSION_TTL_MS=604800000

LEAD_AGENTS_RATE_LIMIT_WINDOW_MS=60000
LEAD_AGENTS_RATE_LIMIT_MAX_REQUESTS=60

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

FOUNDER_ALERT_WEBHOOK_URL=
FOUNDER_ALERT_WEBHOOK_SECRET=
SALES_ALERT_WEBHOOK_URL=
SALES_ALERT_WEBHOOK_SECRET=
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=

OFFICE_FACILITY_BASE_URL=
OFFICE_FACILITY_API_KEY=
OFFICE_FACILITY_BEARER_TOKEN=
OFFICE_FACILITY_EXPORT_PATH=/office/export
OFFICE_CONSUMER_BASE_URL=
OFFICE_CONSUMER_API_KEY=
OFFICE_CONSUMER_BEARER_TOKEN=
OFFICE_CONSUMER_EXPORT_PATH=/office/export
OFFICE_BACKEND_BASE_URL=
OFFICE_BACKEND_API_KEY=
OFFICE_BACKEND_BEARER_TOKEN=

# Office's own publicly-reachable base URL (e.g. https://office.ochiga.com.ng).
# Used to resolve Office-hosted storage URLs into absolute URLs when
# uploading assets (e.g. Development cover images) onward to Sanity.
OFFICE_PUBLIC_BASE_URL=
OFFICE_BACKEND_CONVERSATION_PATH=/office/conversation/corporate
OFFICE_BACKEND_INTERNAL_CONVERSATION_PATH=/office/conversation/internal
OFFICE_BACKEND_EVENTS_ENABLED=false
OFFICE_BACKEND_EVENT_PATH=/office/events/material
OFFICE_BACKEND_EVENT_TIMEOUT_MS=10000
OFFICE_BACKEND_EVENT_MAX_ATTEMPTS=2

OFFICE_EMAIL_PROVIDER=resend
OFFICE_EMAIL_FROM=Ochiga Office <office@ochiga.com.ng>
RESEND_API_KEY=

OFFICE_MAP_PROVIDER=static
MAPBOX_PUBLIC_TOKEN=
GOOGLE_MAPS_API_KEY=
OFFICE_DOCUMENT_BRAND_NAME=OCHIGA OFFICE
OFFICE_STORAGE_DIR=./data/office-storage
